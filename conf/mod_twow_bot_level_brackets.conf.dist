###################################################################################################
# TURTLE WOW BOT LEVEL BRACKETS CONFIGURATION (OPTION 1 ORCHESTRATION)
###################################################################################################

[BotLevelBrackets]

# Master Enable switch
# 1 = Enabled, 0 = Disabled
BotLevelBrackets.Enabled = 1

# Orchestration Mode
# Option 1 architecture strictly uses ExistingNativeTasks.
# Option 2 (augmentation) and Option 3 (relocation) modes are prohibited.
BotLevelBrackets.Orchestration.Mode = ExistingNativeTasks

# DryRun Simulation Mode
# 1 = Evaluates eligibility and logs simulated proposals without calling native gameplay APIs.
# 0 = Normal production execution.
BotLevelBrackets.Orchestration.DryRun = 0

# Cadence for the unified scheduling coordinator (in seconds).
# Default: 90 seconds.
BotLevelBrackets.Orchestration.CheckSeconds = 90

# Maximum new task requests submitted in a single scheduling pass.
# Default: 5.
BotLevelBrackets.Orchestration.MaxRequestsPerCycle = 5

# Maximum outstanding (proposed/submitted/accepted) requests permitted concurrently per faction.
# Default: 10.
BotLevelBrackets.Orchestration.MaxOutstandingPerFaction = 10

# Maximum loose requests (AllowNativeChoice mode) per cycle.
# Default: 1.
BotLevelBrackets.Orchestration.MaxLooseRequestsPerCycle = 1

# Repeat-request cooldown for a bot after completing an orchestrated task (in seconds).
# Default: 1800 (30 minutes).
BotLevelBrackets.Orchestration.RequestCooldownSeconds = 1800

# Backoff cooldown applied to a bot after a native request is rejected (in seconds).
# Default: 600 (10 minutes).
BotLevelBrackets.Orchestration.RejectionBackoffSeconds = 600

# Required persistent deficit duration before issuing new requests to a destination (in seconds).
# Default: 60 seconds.
BotLevelBrackets.Orchestration.StabilitySeconds = 60

# Timeout after which an unconfirmed native dispatch proposal expires (in seconds).
# Default: 30 seconds.
BotLevelBrackets.Orchestration.DispatchTimeoutSeconds = 30

# Cooldown applied when a bot leaves a destination prematurely (in seconds).
# Default: 3600 (1 hour).
BotLevelBrackets.Orchestration.EarlyDepartureBackoffSeconds = 3600

# Handling of bots with ambiguous or unknown native state.
# Valid: ObserveOnly, Reject
BotLevelBrackets.Orchestration.UnknownStatePolicy = ObserveOnly

###################################################################################################
# CITY ORCHESTRATION (RACIAL CAPITALS)
###################################################################################################

# Enable city visit orchestration.
# 1 = Enabled, 0 = Disabled.
BotLevelBrackets.City.Enabled = 1

# Destination honesty policy for cities.
# RequireExact: Only issues requests when the target city is guaranteed by the native API.
# AllowNativeChoice: Permits native task requests where the engine selects the target settlement.
BotLevelBrackets.City.DestinationPolicy = RequireExact

# City Quota Calculation Mode
# 1 = Fixed headcounts per city
# 2 = Percentage of total online faction bots (Default)
BotLevelBrackets.City.QuotaMode = 2

# City Population Bounds Toggles
BotLevelBrackets.City.MinLimitEnabled = 0
BotLevelBrackets.City.MaxLimitEnabled = 1

# Units for city bounds (1 = absolute headcount, 2 = percentage)
BotLevelBrackets.City.LimitsMode = 1

# Minimum and Maximum bots per city
BotLevelBrackets.City.MinBotsPerCity = 0
BotLevelBrackets.City.MaxBotsPerCity = 50

# Hysteresis deadband before acting on population imbalance
BotLevelBrackets.City.HysteresisBots = 2

# Desired dwell duration for bots visiting a city (in milliseconds).
# Default: 180000 (3 minutes).
BotLevelBrackets.City.DwellDurationMs = 180000

# Configured Target Allocation for Racial Capitals:
# Alliance: Stormwind, Ironforge, Darnassus, Alah'Thalas
# Horde: Orgrimmar, Undercity, Thunder Bluff, Sparkwater Port
BotLevelBrackets.City.StormwindTarget = 7
BotLevelBrackets.City.IronforgeTarget = 5
BotLevelBrackets.City.DarnassusTarget = 4
BotLevelBrackets.City.AlahThalasTarget = 4

BotLevelBrackets.City.OrgrimmarTarget = 7
BotLevelBrackets.City.UndercityTarget = 5
BotLevelBrackets.City.ThunderBluffTarget = 4
BotLevelBrackets.City.SparkwaterTarget = 4

###################################################################################################
# OUTDOOR WORLD DISTRIBUTION
###################################################################################################

# Enable outdoor activity encouragement.
# 1 = Enabled, 0 = Disabled.
BotLevelBrackets.World.Enabled = 1

# Destination policy for outdoor tasks.
# RequireExact: Requires exact region parameter (Honest missing control).
# AllowNativeChoice: Allows native AI to pick quest/grind/gather locations.
BotLevelBrackets.World.DestinationPolicy = RequireExact

# Percentage of bot population reserved for the open world (field reserve).
# Default: 70%.
BotLevelBrackets.World.FieldReservePct = 70

###################################################################################################
# LEVEL & POPULATION POLICIES (ADVISORY)
###################################################################################################

# Level distribution mode.
# ObserveNative: Level bracket percentages are observed and reported; zero forced level mutations.
BotLevelBrackets.LevelPolicy.Mode = ObserveNative

# Population headcount mode.
# ObserveNative: Total online bot count is observed; zero independent login/logout loops.
BotLevelBrackets.Population.Mode = ObserveNative

# Dynamic Human Weighting
# When enabled, adjusts target bracket weights based on active human player levels.
BotLevelBrackets.LevelPolicy.UseDynamic = 0
BotLevelBrackets.LevelPolicy.HumanWeight = 1.0
BotLevelBrackets.LevelPolicy.SyncFactions = 0

###################################################################################################
# SOCIAL & IDENTITY PROTECTIONS
###################################################################################################

# Exclude bots on real players' friend lists from module task requests.
BotLevelBrackets.Protection.IgnoreFriendListed = 1

# Exclude bots belonging to guilds containing real players.
BotLevelBrackets.Protection.IgnoreRealPlayerGuilds = 1

# Exclude bots belonging to active arena teams.
BotLevelBrackets.Protection.IgnoreArenaTeams = 1

# Cadence for refreshing social protection caches from the character database (in seconds).
# Default: 300 seconds (5 minutes).
BotLevelBrackets.Protection.SocialRefreshSeconds = 300

# Comma-separated list of bot names immune from module task orchestration.
BotLevelBrackets.Protection.ExcludedBotNames = ""

