###################################################################################################
# LEVELING ZONE DESTINATIONS & TURTLE WOW ZONE LEVEL CHART
# Reference: https://turtle-wow.fandom.com/wiki/Zone_Level_Chart
###################################################################################################
# For each level bracket and faction, you can specify:
# 1. A single location (e.g. "westfall" or "0 -10515.0 1070.0 55.0 0.0")
# 2. A comma-separated pool of locations matching the Turtle WoW Zone Level Chart.
#    When multiple locations are configured, bots will organically disperse across
#    all viable questing zones, outposts, and capital cities across Eastern Kingdoms
#    and Kalimdor upon level scaling.
#
# Available Turtle WoW Zones & Supported .tele Names:
#   Bracket 1 (1-10):   Goldshire, Northshire, Coldridge, Kharanos, Shadowglen, Dolanaar, High Elf,
#                       Valley of Trials, Razor Hill, Sen'jin Village, Deathknell, Brill, Camp Narache,
#                       Bloodhoof Village, Red Cloud, Blackstone Island, and all 8 Capital Cities
#   Bracket 2 (10-19):  Westfall, Sentinel Hill, Thelsamar, Loch Modan, Darkshore, Auberdine,
#                       The Crossroads, Barrens, Silverpine Forest, The Sepulcher, Razor Hill, Capital Cities
#   Bracket 3 (20-29):  Redridge Mountains, Lakeshire, Duskwood, Darkshire, Wetlands, Menethil Harbor,
#                       Ashenvale, Astranaar, Splintertree Post, Zoram'gar Outpost, Stonetalon Mountains,
#                       Sun Rock Retreat, Tarren Mill, Southshore, Balor, Capital Cities
#   Bracket 4 (30-39):  Refuge Pointe, Hammerfall, Arathi Highlands, Southshore, Alterac Mountains,
#                       Rebel Camp, Grom'gol Base Camp, Stranglethorn Vale, Booty Bay, Desolace,
#                       Nijel's Point, Ghost Walker Post, Theramore, Brackenwall Village, Dustwallow Marsh,
#                       Freewind Post, Thousand Needles, Kargath, Badlands, Stonard, Swamp of Sorrows,
#                       Gilneas, Gilneas City, Capital Cities
#   Bracket 5 (40-49):  Feathermoon Stronghold, Camp Mojache, Feralas, Gadgetzan, Tanaris, Aerie Peak,
#                       Revantusk Village, The Hinterlands, Kargath, Badlands, Thorium Point, Searing Gorge,
#                       Stonard, Swamp of Sorrows, Icepoint Rock, Lapidis Isle, Capital Cities
#   Bracket 6 (50-59):  Western Plaguelands, Eastern Plaguelands, Light's Hope Chapel, Winterspring,
#                       Everlook, Felwood, Bloodvenom Post, Morgan's Vigil, Flame Crest, Burning Steppes,
#                       Thorium Point, Un'Goro Crater, Marshal's Refuge, Blasted Lands, Azshara, Valormok,
#                       Silithus, Cenarion Hold, Tel'Abim, Capital Cities
#   Bracket 7 (60):     All Capital Cities (Stormwind, Ironforge, Darnassus, Alah'Thalas, Orgrimmar,
#                       Undercity, Thunder Bluff, Sparkwater Port), Light's Hope Chapel, Silithus,
#                       Cenarion Hold, Winterspring, Everlook, Western Plaguelands, Burning Steppes,
#                       Morgan's Vigil, Flame Crest, Thorium Point, Un'Goro Crater, Valormok

BotLevelBrackets.Alliance.Range1.Locations = "goldshire, northshire, coldridge, kharanos, shadowglen, dolanaar, highelf, stormwind, ironforge, darnassus, alahthalasarrival"
