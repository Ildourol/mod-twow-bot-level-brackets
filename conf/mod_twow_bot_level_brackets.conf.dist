###################################################################################################
# TURTLE WOW BOT LEVEL BRACKETS CONFIGURATION
###################################################################################################

[BotLevelBrackets]

# Master Enable switch
# 1 = Enabled, 0 = Disabled
BotLevelBrackets.Enabled = 1

# DryRun Simulation Mode
# 1 = Evaluates eligibility and logs simulated proposals without calling native gameplay APIs.
# 0 = Normal production execution.
BotLevelBrackets.Orchestration.DryRun = 0

# Cadence for the unified scheduling coordinator (in seconds).
# Default: 90 seconds.
BotLevelBrackets.Orchestration.CheckSeconds = 90

# Maximum new task requests submitted in a single scheduling pass.
# Default: 5.
BotLevelBrackets.Orchestration.MaxRequestsPerCycle = 5

# Maximum outstanding (proposed/submitted/accepted) requests permitted concurrently per faction.
# Default: 10.
BotLevelBrackets.Orchestration.MaxOutstandingPerFaction = 10

# Maximum loose requests (AllowNativeChoice mode) per cycle.
# Default: 1.
BotLevelBrackets.Orchestration.MaxLooseRequestsPerCycle = 1

# Repeat-request cooldown for a bot after completing an orchestrated task (in seconds).
# Default: 1800 (30 minutes).
BotLevelBrackets.Orchestration.RequestCooldownSeconds = 1800

# Backoff cooldown applied to a bot after a native request is rejected (in seconds).
# Default: 600 (10 minutes).
BotLevelBrackets.Orchestration.RejectionBackoffSeconds = 600

# Required persistent deficit duration before issuing new requests to a destination (in seconds).
# Default: 60 seconds.
BotLevelBrackets.Orchestration.StabilitySeconds = 60

# Timeout after which an unconfirmed native dispatch proposal expires (in seconds).
# Default: 30 seconds.
BotLevelBrackets.Orchestration.DispatchTimeoutSeconds = 30

# Cooldown applied when a bot leaves a destination prematurely (in seconds).
# Default: 3600 (1 hour).
BotLevelBrackets.Orchestration.EarlyDepartureBackoffSeconds = 3600

###################################################################################################
# CITY ORCHESTRATION (RACIAL CAPITALS)
###################################################################################################

# Enable city visit orchestration.
# 1 = Enabled, 0 = Disabled.
BotLevelBrackets.City.Enabled = 1

# Destination honesty policy for cities.
# RequireExact: Only issues requests when the target city is guaranteed by the native API.
# AllowNativeChoice: Permits native task requests where the engine selects the target settlement.
BotLevelBrackets.City.DestinationPolicy = RequireExact

# City Quota Calculation Mode
# 1 = Fixed headcounts per city
# 2 = Percentage of total online faction bots (Default)
BotLevelBrackets.City.QuotaMode = 2

# City Population Bounds Toggles
BotLevelBrackets.City.MinLimitEnabled = 0
BotLevelBrackets.City.MaxLimitEnabled = 1

# Units for city bounds (1 = absolute headcount, 2 = percentage)
BotLevelBrackets.City.LimitsMode = 1

# Minimum and Maximum bots per city
BotLevelBrackets.City.MinBotsPerCity = 0
BotLevelBrackets.City.MaxBotsPerCity = 60

# Hysteresis deadband before acting on population imbalance
BotLevelBrackets.City.HysteresisBots = 2

# City Transit Mode
# 1 = Travel / Directions (Default - bot receives travel directions to walk/use flight paths to the city)
# 2 = Teleport (Directly teleports the bot to the city center upon request, as in previous versions)
BotLevelBrackets.City.TransitMode = 2

# Pick bots from all level brackets for city visits (1 = Enabled, 0 = Distance-only bias).
# When enabled, candidates are selected across all level brackets (1-9, 10-19, 20-29, 30-39, 40-49, 50-59, 60),
# ensuring high-level bots visit capital cities alongside low-level bots.
BotLevelBrackets.City.PickAllBrackets = 1

# Minimum level required for a bot to be eligible for a capital city visit.
# Characters under level 10 remain in starting zones (Northshire, Coldridge, Shadowglen, Valley of Trials, etc.)
# Default: 10
BotLevelBrackets.City.MinLevel = 10

# Desired dwell duration for bots visiting a city (in milliseconds).
# Default: 300000 (5 minutes).
BotLevelBrackets.City.DwellDurationMs = 300000

# Minimum dwell duration before bot may finish errands and depart (in milliseconds).
# Default: 300000 (5 minutes).
BotLevelBrackets.City.MinDwellDurationMs = 300000

# Maximum dwell duration before bot is unconditionally released to open world (in milliseconds).
# Default: 600000 (10 minutes).
BotLevelBrackets.City.MaxDwellDurationMs = 600000

# Configured Target Allocation for Racial Capitals (% of faction bots):
# Alliance: Stormwind (10%), Ironforge (8%), Darnassus (6%), Alah'Thalas (6%) -> Total: 30%
# Horde: Orgrimmar (10%), Undercity (8%), Thunder Bluff (6%), Sparkwater Port (6%) -> Total: 30%
BotLevelBrackets.City.StormwindTarget = 10
BotLevelBrackets.City.IronforgeTarget = 8
BotLevelBrackets.City.DarnassusTarget = 6
BotLevelBrackets.City.AlahThalasTarget = 6

BotLevelBrackets.City.OrgrimmarTarget = 10
BotLevelBrackets.City.UndercityTarget = 8
BotLevelBrackets.City.ThunderBluffTarget = 6
BotLevelBrackets.City.SparkwaterTarget = 6

# Major City Teleport Location Names & Bank Arrival Coordinates
# Specifies the .tele command location name or exact coordinates (map x y z o)
# when bots teleport to each racial capital city. Arriving bots land with a natural
# 1.0 - 2.5 yard dispersion offset and ground height sampling.
#
# Available .tele Location Names:
#   Stormwind:     "stormwind"
#   Ironforge:     "ironforge"
#   Darnassus:     "darnassus"
#   Alah'Thalas:   "alahthalasarrival" (or "alahthalasentrance", "highelf")
#   Orgrimmar:     "orgrimmar"
#   Undercity:     "undercity"
#   Thunder Bluff: "thunderbluff"
#   Sparkwater:    "sparkwater"
#
# Alternatively, specify exact internal bank coordinates:
#   Stormwind Bank:    "0 -8935.27 613.13 99.61 0.45"   (Trade District Bank)
#   Ironforge Bank:    "0 -4886.55 -997.59 504.02 2.23" (The Great Forge Bank)
#   Darnassus Bank:    "1 9938.84 2521.53 1317.66 4.38" (Darnassus Bank Tree)
#   Alah'Thalas Bank:  "0 4261.59 -2842.02 8.45 0.08"   (Banker Shalanna, Alah'Thalas Bank)
#   Orgrimmar Bank:    "1 1627.32 -4376.07 11.81 3.44"  (Valley of Strength Bank)
#   Undercity Bank:    "0 1599.96 240.65 -52.06 0.09"   (Central Bank Ring)
#   ThunderBluff Bank: "1 -1257.63 19.56 128.27 1.73"   (Lower Rise Bank)
#   Sparkwater Bank:   "1 838.27 -5048.73 6.03 1.92"    (Sparkwater Port Bank)
BotLevelBrackets.City.Stormwind.Location = "stormwind"
BotLevelBrackets.City.Ironforge.Location = "ironforge"
BotLevelBrackets.City.Darnassus.Location = "darnassus"
BotLevelBrackets.City.AlahThalas.Location = "alahthalasarrival"
BotLevelBrackets.City.Orgrimmar.Location = "orgrimmar"
BotLevelBrackets.City.Undercity.Location = "undercity"
BotLevelBrackets.City.ThunderBluff.Location = "thunderbluff"
BotLevelBrackets.City.Sparkwater.Location = "sparkwater"

###################################################################################################
# OUTDOOR WORLD DISTRIBUTION
###################################################################################################

# Enable outdoor activity encouragement.
# 1 = Enabled, 0 = Disabled (Default: 1).
BotLevelBrackets.World.Enabled = 1

# Destination policy for outdoor tasks.
# RequireExact: Requires exact region parameter (Honest missing control).
# AllowNativeChoice: Allows native AI to pick quest/grind/gather locations.
BotLevelBrackets.World.DestinationPolicy = RequireExact

# Percentage of bot population reserved for the open world (field reserve).
# Default: 70%.
BotLevelBrackets.World.FieldReservePct = 70

###################################################################################################
# LEVEL DISTRIBUTION & BOOST ENGINE
###################################################################################################

# Master toggle for active level bracket rebalancing and bot level adjustments.
# 1 = Active redistribution (boost/reset), 0 = Disabled.
BotLevelBrackets.LevelDistribution.Enabled = 1

# Cadence for the level distribution rebalancing check (in seconds).
# Default: 300 (5 minutes).
BotLevelBrackets.LevelDistribution.CheckFrequency = 300

# Cadence for processing queued/flagged bot level adjustments (in seconds).
# Default: 15 seconds.
BotLevelBrackets.LevelDistribution.CheckFlaggedFrequency = 15

# Maximum number of flagged bots to level-adjust per tick.
# Default: 5.
BotLevelBrackets.LevelDistribution.FlaggedProcessLimit = 5

# Minimum surplus bots in a bracket before redistribution moves bots out of it.
# Default: 2.
BotLevelBrackets.LevelDistribution.MinBracketChangeThreshold = 2

# Maximum size of the in-memory pending reset queue (0 = unlimited).
# Default: 0.
BotLevelBrackets.LevelDistribution.MaxPendingQueueSize = 0

# Maximum time a bot can remain in the in-memory pending reset queue (in seconds, 0 = no TTL).
# Default: 0.
BotLevelBrackets.LevelDistribution.PendingQueueTTL = 0

# Teleport on level adjustment:
# When enabled, bots are safely dismounted and teleported to their leveling zone
# or native racial starter valley after their level is adjusted.
# 1 = Enabled (Default), 0 = Disabled.
BotLevelBrackets.TeleportOnLevelChange = 1

#
# WMO Floor Arrival Hold & Anti-Fall Engine (mod-twow-arrival-floor)
# Prevents bots from falling through bridges, docks, and WMO gameobject floors upon arrival.
# When enabled, samples cross-map dynamic floor height and monitors the bot's floor Z.
# If a bot falls below the arrival floor during loading/streaming, it is instantly lifted back.
# 1 = Enabled (Default), 0 = Disabled.
#
BotLevelBrackets.Teleport.ArrivalFloorHold = 1

# Duration (in milliseconds) to hold and monitor the bot's floor Z after teleporting.
# Default: 5000 ms (5 seconds).
BotLevelBrackets.Teleport.ArrivalHoldDurationMs = 5000

# Maximum number of lift corrections permitted per teleport arrival.
# Default: 6.
BotLevelBrackets.Teleport.MaxFloorLifts = 6

###################################################################################################
# STARTING ZONE & WRONG MAP DISPERSAL
###################################################################################################

# Enable automatic evacuation of over-leveled bots (> Level 9) from the 8 starter valleys
# (Northshire, Coldridge, Shadowglen, Thalassian Highlands, Valley of Trials, Red Cloud Mesa, Deathknell, Blackstone Island).
# 1 = Enabled, 0 = Disabled.
BotLevelBrackets.StartingZoneDisperse.Enabled = 1

# Frequency (in seconds) at which starting-zone dispersal runs.
# Default: 15 seconds (matching responsive WotLK baseline).
BotLevelBrackets.StartingZoneDisperse.Frequency = 15

# Enable automatic evacuation of bots stranded on invalid or non-continental maps.
# 1 = Enabled, 0 = Disabled.
BotLevelBrackets.WrongMapDisperse.Enabled = 1

# Frequency (in seconds) at which wrong-map dispersal runs.
# Default: 60 seconds (matching responsive WotLK baseline).
BotLevelBrackets.WrongMapDisperse.Frequency = 60

###################################################################################################
# LEVEL & POPULATION POLICIES
###################################################################################################

# Dynamic Human Weighting
# When enabled, adjusts target bracket weights based on active human player levels.
BotLevelBrackets.LevelPolicy.UseDynamic = 0
BotLevelBrackets.LevelPolicy.HumanWeight = 1.0
BotLevelBrackets.LevelPolicy.SyncFactions = 0

