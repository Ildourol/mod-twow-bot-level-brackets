[BotLevelBrackets]
#
# Module: Bot Level Brackets Extended for Turtle WoW (vMaNGOS)
# Unified City & Outdoor World Native Opportunities, Capital Hub Ambiance & Diagnostics
#

###############################################################################
# 1. CORE MASTER SWITCHES & DOMAINS
###############################################################################

#
# BotLevelBrackets.Enabled
# Enables or disables the Bot Level Brackets Extended module.
# Default: 1 (Enabled)
#
BotLevelBrackets.Enabled = 1

#
# BotLevelBrackets.City.Enabled
# Enables capital city opportunity generation.
# Default: 1 (Enabled)
#
BotLevelBrackets.City.Enabled = 1

#
# BotLevelBrackets.World.Enabled
# Enables outdoor world opportunity generation.
# Default: 1 (Enabled)
#
BotLevelBrackets.World.Enabled = 1

#
# BotLevelBrackets.City.ActivationMode
# Method used to attach extension AI contexts to bots.
# Values: Augmenter (external AiContextAugment seam)
# Default: Augmenter
#
BotLevelBrackets.City.ActivationMode = Augmenter


###############################################################################
# 2. SHARED SCHEDULING BUDGETS & OPPORTUNITY CADENCE
###############################################################################

#
# BotLevelBrackets.Opportunities.CheckSeconds
# Cadence (in seconds) between distribution scheduling evaluations.
# Default: 90
#
BotLevelBrackets.Opportunities.CheckSeconds = 90

#
# BotLevelBrackets.Opportunities.StabilitySeconds
# Deficit persistence and proposed opportunity TTL (in seconds).
# Default: 60
#
BotLevelBrackets.Opportunities.StabilitySeconds = 60

#
# BotLevelBrackets.Opportunities.MaxAdmissionsPerCycle
# Maximum combined opportunities (City + World + Fallback) admitted per cycle.
# Default: 5
#
BotLevelBrackets.Opportunities.MaxAdmissionsPerCycle = 5

#
# BotLevelBrackets.Opportunities.MaxOutstandingPerFaction
# Maximum combined active and pending opportunities per faction.
# Default: 10
#
BotLevelBrackets.Opportunities.MaxOutstandingPerFaction = 10

#
# BotLevelBrackets.Opportunities.CrossDomainCooldownSeconds
# Minimum cooldown before a bot may transition between City and World domains.
# Prevents rapid oscillation between field questing and capital visits.
# Default: 1800 (30 minutes)
#
BotLevelBrackets.Opportunities.CrossDomainCooldownSeconds = 1800

#
# BotLevelBrackets.Opportunities.FailureBackoffSeconds
# Backoff interval after a failed destination search or execution error.
# Default: 600 (10 minutes)
#
BotLevelBrackets.Opportunities.FailureBackoffSeconds = 600


###############################################################################
# 3. OUTDOOR WORLD DISTRIBUTION & FIELD RESERVE
###############################################################################

#
# BotLevelBrackets.World.FieldReservePct
# Minimum intended non-city bot supply share (0-100%).
# City demand cannot draw below this guaranteed outdoor population reserve.
# Default: 70 (70% of bots reserved for open world)
#
BotLevelBrackets.World.FieldReservePct = 70

#
# BotLevelBrackets.World.MaxInboundPerRegion
# Maximum inbound bot travel reservations allowed per outdoor region.
# Default: 3
#
BotLevelBrackets.World.MaxInboundPerRegion = 3

#
# BotLevelBrackets.World.FollowHumanLocations
# Whether to bias outdoor destination demand toward zones with active human players.
# Default: 0 (Disabled)
#
BotLevelBrackets.World.FollowHumanLocations = 0

#
# BotLevelBrackets.World.RegionConfig
# Optional external path to custom region policy configuration file.
# Default: ""
#
BotLevelBrackets.World.RegionConfig = ""


###############################################################################
# 4. LEVEL POLICY & ADVISORY REPORTING
###############################################################################

#
# BotLevelBrackets.LevelPolicy.Mode
# Policy for level distribution. Character levels progress naturally.
# Values: ObserveNative (advisory observation of native login ladder)
# Default: ObserveNative
#
BotLevelBrackets.LevelPolicy.Mode = ObserveNative

#
# BotLevelBrackets.LevelPolicy.ReportDesiredTargets
# Whether to include desired vs actual bracket targets in status reports.
# Default: 1
#
BotLevelBrackets.LevelPolicy.ReportDesiredTargets = 1

#
# BotLevelBrackets.LevelPolicy.MinChangeThreshold
# Damping threshold for dynamic bracket quota adjustments.
# Default: 1
#
BotLevelBrackets.LevelPolicy.MinChangeThreshold = 1

#
# BotLevelBrackets.LevelPolicy.RealPlayerWeight
# Multiplier weighting real human player level locations in dynamic blend.
# Formula: alpha = RealPlayerWeight / (1 + RealPlayerWeight)
# Default: 1.0
#
BotLevelBrackets.LevelPolicy.RealPlayerWeight = 1.0

#
# BotLevelBrackets.LevelPolicy.SyncFactions
# Synchronize level bracket demand across Alliance and Horde.
# Default: 0
#
BotLevelBrackets.LevelPolicy.SyncFactions = 0


###############################################################################
# 5. CAPITAL CITY HUB QUOTAS & LIMITS
###############################################################################

#
# BotLevelBrackets.HubDisperse.QuotaMode
# Method for computing city target headcounts.
# 1 = Fixed bot headcount
# 2 = Percentage of online faction bots
# Default: 2
#
BotLevelBrackets.HubDisperse.QuotaMode = 2

#
# BotLevelBrackets.HubDisperse.LimitsMode
# Method for bounding city targets.
# 0 = Disabled
# 1 = Fixed headcount limits (MinBotsPerHub / MaxBotsPerHub)
# 2 = Percentage limits
# Default: 1
#
BotLevelBrackets.HubDisperse.LimitsMode = 1

#
# BotLevelBrackets.HubDisperse.MinBotsLimitEnabled
# Enforce a minimum population bound for each city.
# Default: 0
#
BotLevelBrackets.HubDisperse.MinBotsLimitEnabled = 0

#
# BotLevelBrackets.HubDisperse.MaxBotsLimitEnabled
# Enforce a maximum population ceiling for each city.
# Default: 1
#
BotLevelBrackets.HubDisperse.MaxBotsLimitEnabled = 1

#
# BotLevelBrackets.HubDisperse.MinBotsPerHub
# Minimum bound value (headcount or percent).
# Default: 0
#
BotLevelBrackets.HubDisperse.MinBotsPerHub = 0

#
# BotLevelBrackets.HubDisperse.MaxBotsPerHub
# Maximum bound value (headcount or percent).
# Default: 50
#
BotLevelBrackets.HubDisperse.MaxBotsPerHub = 50

#
# BotLevelBrackets.HubDisperse.HysteresisBots
# Deadband threshold to prevent admission churn on marginal deficits.
# Default: 2
#
BotLevelBrackets.HubDisperse.HysteresisBots = 2

# Capital City Target Quotas (Alliance: Stormwind, Ironforge, Darnassus, Alah'Thalas)
BotLevelBrackets.HubDisperse.StormwindPct = 7
BotLevelBrackets.HubDisperse.IronforgePct = 5
BotLevelBrackets.HubDisperse.DarnassusPct = 4
BotLevelBrackets.HubDisperse.AlahThalasPct = 4

# Capital City Target Quotas (Horde: Orgrimmar, Undercity, Thunder Bluff, Sparkwater)
BotLevelBrackets.HubDisperse.OrgrimmarPct = 7
BotLevelBrackets.HubDisperse.UndercityPct = 5
BotLevelBrackets.HubDisperse.ThunderBluffPct = 4
BotLevelBrackets.HubDisperse.SparkwaterPct = 4


###############################################################################
# 6. RESTRICTED CITY RELOCATION FALLBACK
###############################################################################

#
# BotLevelBrackets.City.Fallback.Enabled
# Explicit opt-in for restricted city relocation fallback.
# OFF by default. Never triggered by slow travel, retries, or timeouts.
# Default: 0
#
BotLevelBrackets.City.Fallback.Enabled = 0

#
# BotLevelBrackets.City.Fallback.Cities
# Comma-separated allowlist of city names permitted for fallback relocation.
# Default: ""
#
BotLevelBrackets.City.Fallback.Cities = ""

#
# BotLevelBrackets.City.Fallback.AllowedReason
# Only allowlisted automated reason permitted for preflight fallback.
# Default: NativeRouteUnsupportedBeforeStart
#
BotLevelBrackets.City.Fallback.AllowedReason = NativeRouteUnsupportedBeforeStart

#
# BotLevelBrackets.City.Fallback.MaxPerCycle
# Maximum fallback transfers permitted per scheduling cycle.
# Default: 1
#
BotLevelBrackets.City.Fallback.MaxPerCycle = 1

#
# BotLevelBrackets.City.Fallback.MaxPerHour
# Rolling global limit on fallback transfers per hour.
# Default: 2
#
BotLevelBrackets.City.Fallback.MaxPerHour = 2

#
# BotLevelBrackets.City.Fallback.MaxSharePct
# Maximum share (0-100%) of total admissions that can be fallback relocations.
# Default: 10
#
BotLevelBrackets.City.Fallback.MaxSharePct = 10

#
# BotLevelBrackets.City.Fallback.CooldownSeconds
# Repeat relocation cooldown per bot per city.
# Default: 7200 (2 hours)
#
BotLevelBrackets.City.Fallback.CooldownSeconds = 7200

#
# BotLevelBrackets.City.Fallback.EarlyDepartureSeconds
# Observation window to detect early departures after arrival.
# Default: 120
#
BotLevelBrackets.City.Fallback.EarlyDepartureSeconds = 120

#
# BotLevelBrackets.City.Fallback.EarlyDepartureBackoffSeconds
# Penalty backoff applied when a relocated bot leaves immediately.
# Default: 21600 (6 hours)
#
BotLevelBrackets.City.Fallback.EarlyDepartureBackoffSeconds = 21600


###############################################################################
# 7. SOCIAL PROTECTION & EXCLUSIONS
###############################################################################

#
# BotLevelBrackets.ExcludeNames
# Comma-separated list of bot character names permanently exempt from redistribution.
# Default: ""
#
BotLevelBrackets.ExcludeNames = ""

#
# BotLevelBrackets.ProtectFriends
# Protect bots on real human players' friend lists from scheduled opportunities.
# Default: 1
#
BotLevelBrackets.ProtectFriends = 1

#
# BotLevelBrackets.ProtectGuilds
# Protect bots belonging to guilds containing real human players.
# Default: 1
#
BotLevelBrackets.ProtectGuilds = 1

#
# BotLevelBrackets.ProtectOfflineHumans
# Persist guild protection even when human guild members are offline.
# Default: 1
#
BotLevelBrackets.ProtectOfflineHumans = 1

#
# BotLevelBrackets.SocialCacheRefreshSeconds
# Cadence (in seconds) for refreshing social friend lists and guild tracking caches.
# Default: 120
#
BotLevelBrackets.SocialCacheRefreshSeconds = 120


###############################################################################
# 8. NATIVE ACTIVITIES CATALOG CONTROLS (43 ACTIVITIES)
###############################################################################

#
# BotLevelBrackets.Activities.Enabled
# Master switch for activities framework.
# Default: 1
#
BotLevelBrackets.Activities.Enabled = 1

#
# BotLevelBrackets.Activities.RequireSupported
# Reject policy atomically if an unsupported activity is enabled.
# Default: 0
#
BotLevelBrackets.Activities.RequireSupported = 0

