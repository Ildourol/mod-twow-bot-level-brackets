BotLevelBrackets.Activities.RandomJump.Weight = 0.2
BotLevelBrackets.Activities.RandomJump.CooldownSeconds = 300
BotLevelBrackets.Activities.RandomJump.MaxOutstandingPerFaction = 1


###############################################################################
# 9. MODULE-LOCAL DEBUG ENVIRONMENT & TELEMETRY
###############################################################################

#
# BotLevelBrackets.Debug.Mode
# Operational debugging mode.
# Values: Off, Summary, Trace, DryRun
# Default: Off
#
BotLevelBrackets.Debug.Mode = Off

#
# BotLevelBrackets.Debug.Output
# Destination sink for debug event logs.
# Values: CoreLog, Export
# Default: CoreLog
#
BotLevelBrackets.Debug.Output = CoreLog

#
# BotLevelBrackets.Debug.Categories
# Comma-separated list of active debug categories or 'All'.
# Default: Summary
#
BotLevelBrackets.Debug.Categories = Summary

# Filters for scoped debugging
BotLevelBrackets.Debug.BotGuids = ""
BotLevelBrackets.Debug.Activities = ""
BotLevelBrackets.Debug.Cities = ""
BotLevelBrackets.Debug.Regions = ""

# Sampling & rate limits
BotLevelBrackets.Debug.SamplePct = 10
BotLevelBrackets.Debug.MaxEventsPerSecond = 50
BotLevelBrackets.Debug.RingBufferEvents = 2000
BotLevelBrackets.Debug.RetentionSeconds = 3600
BotLevelBrackets.Debug.Performance.Enabled = 1
BotLevelBrackets.Debug.Assertions.Enabled = 0

# JSONL Export settings
BotLevelBrackets.Debug.Export.Enabled = 0
BotLevelBrackets.Debug.Export.Directory = logs/bot_level_brackets
BotLevelBrackets.Debug.Export.MaxFileMiB = 10
BotLevelBrackets.Debug.Export.MaxFiles = 5
BotLevelBrackets.Debug.TraceMaxSeconds = 300


