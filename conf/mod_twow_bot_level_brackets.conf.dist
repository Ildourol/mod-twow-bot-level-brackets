###################################################################################################
# TURTLE WOW BOT LEVEL BRACKETS CONFIGURATION
###################################################################################################

[BotLevelBrackets]

# Master Enable switch
# 1 = Enabled, 0 = Disabled
BotLevelBrackets.Enabled = 1

###################################################################################################
# LEVEL DISTRIBUTION & BOOST ENGINE
###################################################################################################

# Master toggle for active level bracket rebalancing and bot level adjustments.
# 1 = Active redistribution (boost/reset), 0 = Disabled.
BotLevelBrackets.LevelDistribution.Enabled = 1

# Cadence for the level distribution rebalancing check (in seconds).
# Default: 300 (5 minutes).
BotLevelBrackets.LevelDistribution.CheckFrequency = 300

# Teleport on level adjustment:
# When enabled, bots are safely dismounted and teleported to their leveling zone
# or native racial starter valley after their level is adjusted.
# 1 = Enabled (Default), 0 = Disabled.
BotLevelBrackets.TeleportOnLevelChange = 1

# Enable automatic evacuation of over-leveled bots (> Level 9) from the 8 starter valleys.
# 1 = Enabled, 0 = Disabled.
BotLevelBrackets.StartingZoneDisperse.Enabled = 1

# Enable automatic evacuation of bots stranded on invalid or non-continental maps.
# 1 = Enabled, 0 = Disabled.
BotLevelBrackets.WrongMapDisperse.Enabled = 1

###################################################################################################
# LEVEL BRACKET DISTRIBUTION (PERCENTAGES)
# Configure what percentage of faction bots should be in each level bracket (must sum to 100%).
# Canonical Vanilla Brackets:
#   Range 1: Levels  1-9
#   Range 2: Levels 10-19
#   Range 3: Levels 20-29
#   Range 4: Levels 30-39
#   Range 5: Levels 40-49
#   Range 6: Levels 50-59
#   Range 7: Level  60
###################################################################################################

# Alliance Level Distribution (% of Alliance bots in each bracket):
BotLevelBrackets.Alliance.Range1.Pct = 16
BotLevelBrackets.Alliance.Range2.Pct = 14
BotLevelBrackets.Alliance.Range3.Pct = 14
BotLevelBrackets.Alliance.Range4.Pct = 14
BotLevelBrackets.Alliance.Range5.Pct = 14
BotLevelBrackets.Alliance.Range6.Pct = 14
BotLevelBrackets.Alliance.Range7.Pct = 14

# Horde Level Distribution (% of Horde bots in each bracket):
BotLevelBrackets.Horde.Range1.Pct = 16
BotLevelBrackets.Horde.Range2.Pct = 14
BotLevelBrackets.Horde.Range3.Pct = 14
BotLevelBrackets.Horde.Range4.Pct = 14
BotLevelBrackets.Horde.Range5.Pct = 14
BotLevelBrackets.Horde.Range6.Pct = 14
BotLevelBrackets.Horde.Range7.Pct = 14

###################################################################################################
# CAPITAL CITY VISITS
###################################################################################################

# Enable capital city visit orchestration.
# 1 = Enabled, 0 = Disabled.
BotLevelBrackets.City.Enabled = 1

# City Transit Mode:
# 1 = Travel / Walk (bot receives travel directions to walk or use flight paths)
# 2 = Teleport (Directly teleports the bot to the city landing location - Default)
BotLevelBrackets.City.TransitMode = 2

# Maximum bots permitted concurrently in any single capital city.
# Default: 60.
BotLevelBrackets.City.MaxBotsPerCity = 60

# Pick bots from all level brackets for city visits (1 = Enabled, 0 = Distance-only bias).
# When enabled, candidates are selected across all level brackets (1-9 through 60).
BotLevelBrackets.City.PickAllBrackets = 1

# Minimum level required for a bot to visit capital cities.
# Default: 1 (allowing bots across all brackets 1-7 to visit capital cities).
BotLevelBrackets.City.MinLevel = 1

# Duration for bots to dwell in a city performing chores/errands before leaving (in milliseconds).
# Default: 300000 (5 minutes).
BotLevelBrackets.City.DwellDurationMs = 300000

# Target Allocation for Alliance Capital Cities (% of Alliance bots visiting each city):
BotLevelBrackets.City.StormwindTarget = 10
BotLevelBrackets.City.IronforgeTarget = 8
BotLevelBrackets.City.DarnassusTarget = 6
BotLevelBrackets.City.AlahThalasTarget = 6

# Target Allocation for Horde Capital Cities (% of Horde bots visiting each city):
BotLevelBrackets.City.OrgrimmarTarget = 10
BotLevelBrackets.City.UndercityTarget = 8
BotLevelBrackets.City.ThunderBluffTarget = 6
BotLevelBrackets.City.SparkwaterTarget = 6

###################################################################################################
# OUTDOOR WORLD DISTRIBUTION
###################################################################################################

# Enable outdoor activity encouragement / census tracking.
# 1 = Enabled, 0 = Disabled.
BotLevelBrackets.World.Enabled = 1

# Percentage of total bot population reserved for the open world.
# Default: 70%.
BotLevelBrackets.World.FieldReservePct = 70

###################################################################################################
# SOCIAL & IDENTITY PROTECTIONS
###################################################################################################

# Exclude bots on real players' friend lists from module task requests.
BotLevelBrackets.Protection.IgnoreFriendListed = 1

# Exclude bots belonging to guilds containing real players.
BotLevelBrackets.Protection.IgnoreRealPlayerGuilds = 1

# Exclude bots belonging to active arena teams.
BotLevelBrackets.Protection.IgnoreArenaTeams = 1

# Comma-separated list of specific bot names immune from module task orchestration.
BotLevelBrackets.Protection.ExcludedBotNames = ""

###################################################################################################
# ACTIVITY REGISTRY CONTROLS
###################################################################################################

# Master toggle for native bot activities in the registry.
# 1 = Enabled (Default, all native TortoiseBots actions active), 0 = Disabled.
BotLevelBrackets.Activities.Enabled = 1

###################################################################################################
# DEBUGGING & DIAGNOSTICS
###################################################################################################

# Debug output mode: Off, Summary, Trace, DryRun
BotLevelBrackets.Debug.Mode = Off
